generator client { provider = "prisma-client-js" }
datasource db { provider = "postgresql" url = env("DATABASE_URL") }
model Monitor { id String @id @default(cuid()) name String url String intervalSeconds Int @default(60) checks Check[] } model Check { id String @id @default(cuid()) monitorId String ok Boolean statusCode Int? latencyMs Int error String? checkedAt DateTime @default(now()) }